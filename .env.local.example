# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard/project/<project>/settings/api

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# There is no self sign-up. Staff accounts are created by invitation from the
# Supabase dashboard (Authentication, Users, Invite user).
