# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard/project/<project>/settings/api

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Shared access code required to self sign-up. Ships in the browser bundle, so
# it is a deterrent, not a secret. If unset, sign-up is disabled (fail safe).
VITE_SIGNUP_ACCESS_CODE=choose-a-team-code
